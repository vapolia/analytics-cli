<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>vana</AssemblyName>
    <!-- One native file per platform: dotnet publish -r win-x64 (or osx-arm64, linux-x64) -c Release. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vapolia.Analytics.Clients\Vapolia.Analytics.Clients.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vapolia.Analytics.AnalyticsCli.Tests" />
  </ItemGroup>

</Project>
